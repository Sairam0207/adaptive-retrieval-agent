# Required: Google Gemini API access (grading, reformulation, generation) — free tier, no billing required
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Models
GRADER_MODEL=gemini-flash-lite-latest
GENERATOR_MODEL=gemini-flash-latest

# Vector store: local on-disk Qdrant, no server needed by default
QDRANT_PATH=./data/qdrant_local
QDRANT_URL=
QDRANT_COLLECTION=ara_docs

# Embeddings + reranker (local, free, no API key needed)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Agent behavior
MAX_RETRIES=2
TOP_K_RETRIEVE=20
TOP_K_RERANK=5

# Observability (optional — leave blank to fall back to local console/JSON logging)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
